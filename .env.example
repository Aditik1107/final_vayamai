# ============================================================
# VyayamAI Monorepo — Root .env.example
# Copy the relevant section into each app's env file
# ============================================================

# ── Supabase / PostgreSQL ──────────────────────────────────
# Get these from: Supabase Dashboard → Project → Settings → Database

# For apps/web/.env.local (Prisma needs both)
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>:6543/<db>?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>:5432/<db>"

# For backend/.env (Express + pg)
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>:6543/<db>"
# OR individual fields:
DB_HOST="aws-0-ap-south-1.pooler.supabase.com"
DB_PORT="6543"
DB_USER="postgres.<project-ref>"
DB_PASSWORD="<your-db-password>"
DB_NAME="postgres"

# ── JWT ───────────────────────────────────────────────────
# Must be the SAME value in both apps/web and backend for cross-app auth
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# ── Next.js Web (apps/web) ────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BACKEND_URL="http://localhost:5000"

# ── Backend (backend/) ───────────────────────────────────
PORT="5000"
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000,http://10.0.2.2:3000"

# ── Mobile (apps/mobile) ─────────────────────────────────
# Android emulator → host machine
VYAYAMAI_API_URL=http://10.0.2.2:5000/api
# iOS simulator or device on same LAN
# VYAYAMAI_API_URL=http://192.168.1.x:5000/api

# ── Email (optional — for verification emails) ───────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="VyayamAI <noreply@vyayamai.com>"
RESEND_API_KEY=""
